{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for every window (the first is \"main\", others \"window-<n>\")",
  "windows": ["main", "window-*"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "dialog:default",
    "opener:default",
    "drag:default",
    "updater:default",
    "process:allow-restart",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text"
  ]
}
